# Copy to .env (never commit .env). Used by docker-compose.yml.

# SQL Server "sa" password: 8+ chars with upper, lower, digit and symbol.
DB_PASSWORD=

# JWT signing secret: 32+ random characters, e.g. from: openssl rand -base64 48
JWT_SIGNING_KEY=

# Public address of the site (used in email links). Session cookies are Secure, so a real
# domain must be served over HTTPS (put a TLS proxy or load balancer in front of port 8080).
PUBLIC_URL=http://localhost:8080

# Optional SMTP; without it, emails are written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@primehomes.local
